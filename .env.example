# ── Database ──────────────────────────────────────
DATABASE_URL="postgresql://cnt_admin:cnt_admin_dev_password@localhost:5432/cnt_project?schema=public"

# ── Auth & Security ──────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-change-me-in-production-0123456789abcdefghijklmnopqrstuvwxyz"
SESSION_TTL_DAYS="7"
CRON_SECRET="production-cron-secret-key-change-me"

# ── App Details ───────────────────────────────────
NEXT_PUBLIC_APP_NAME="TechNova Flow"
NEXT_PUBLIC_ORG_NAME="TechNova Global Pvt. Ltd."
NEXT_PUBLIC_APP_URL="https://technova-flow.vercel.app"

# ── Uploads ───────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"

# ── Rate Limiting ─────────────────────────────────
MAX_LOGIN_ATTEMPTS="5"
LOGIN_WINDOW_MINUTES="15"

# ── External Email (Optional — Resend or SMTP) ────
RESEND_API_KEY=""
EMAIL_FROM="TechNova Flow <notifications@technova.com>"

# ── Single Sign-On (Optional — Google / GitHub / Microsoft) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_TENANT_ID=""